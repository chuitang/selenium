# Docker Compose environment variable file
# Used for unified proxy configuration management

# Basic proxy configuration
HTTP_PROXY=http://proxy.example.com:8080
HTTPS_PROXY=http://proxy.example.com:8080
NO_PROXY=localhost,127.0.0.1,docker-registry.example.com,.corp

# Lowercase versions (required by some applications)
http_proxy=http://proxy.example.com:8080
https_proxy=http://proxy.example.com:8080
no_proxy=localhost,127.0.0.1,docker-registry.example.com,.corp

# If authentication is required, use the following format:
# HTTP_PROXY=http://username:password@proxy.example.com:8080
# HTTPS_PROXY=http://username:password@proxy.example.com:8080