# Cookie管理器环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改

# 网站登录凭据
USERNAME=your_username
PASSWORD=your_password

# 数据库配置
DATABASE__URL=sqlite:///data/cookies.db

# 浏览器配置
BROWSER__HEADLESS=true
BROWSER__TIMEOUT=30
BROWSER__USER_AGENT=
BROWSER__VIEWPORT_WIDTH=1920
BROWSER__VIEWPORT_HEIGHT=1080

# 代理配置 (可选)
# 代理服务器地址，支持 http、https、socks4、socks5
# BROWSER__PROXY_SERVER=http://127.0.0.1:7890
# BROWSER__PROXY_SERVER=socks5://127.0.0.1:1080
# BROWSER__PROXY_USERNAME=proxy_user
# BROWSER__PROXY_PASSWORD=proxy_pass

# 调度器配置
SCHEDULER__CHECK_INTERVAL_MINUTES=30
SCHEDULER__RETRY_ATTEMPTS=3
SCHEDULER__RETRY_DELAY_SECONDS=5
SCHEDULER__COOKIE_EXPIRY_THRESHOLD_HOURS=24

# 日志配置
LOGGING__LEVEL=INFO
LOGGING__FILE_PATH=cookie_manager.log
LOGGING__MAX_BYTES=10000000
LOGGING__BACKUP_COUNT=5

# 全局配置
DEBUG=false
DATA_DIR=data

# 网站配置示例 (通过配置文件或代码配置)
# WEBSITES__0__NAME=example_site
# WEBSITES__0__URL=https://example.com
# WEBSITES__0__USERNAME=your_username
# WEBSITES__0__PASSWORD=your_password
# WEBSITES__0__LOGIN__URL=https://example.com/login